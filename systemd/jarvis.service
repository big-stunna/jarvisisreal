[Unit]
Description=J.A.R.V.I.S. Digital Assistant
Documentation=https://github.com/big-stunna/jarvisisreal
After=graphical-session.target pipewire.service
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/jarvis/.venv/bin/jarvis daemon
Restart=on-failure
RestartSec=5s

# Pass the Wayland/display environment from the login session
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR DISPLAY DBUS_SESSION_BUS_ADDRESS

# Runtime dir for the socket
RuntimeDirectory=jarvis
RuntimeDirectoryMode=0700

# Logging: stdout/stderr go to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

# Resource limits — keep it light
MemoryMax=800M
CPUQuota=80%

[Install]
WantedBy=graphical-session.target
